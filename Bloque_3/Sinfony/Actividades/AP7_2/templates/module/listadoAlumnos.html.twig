{% extends 'base.html.twig' %}

{% block title %}Listado Alumnos{% endblock %}

{% block body %}
    <h1>Listado Alumnos</h1>
    <h2>{{ module.name }}</h2>
    <table class="table">
        <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Email</th>
            <th>Age</th>
            <th>actions</th>
        </tr>
        </thead>
        <tbody>
        {% for student in module.getIdStudent %}
            <tr>
                <td>{{ student.id }}</td>
                <td>{{ student.name }}</td>
                <td>{{ student.email }}</td>
                <td>{{ student.age }}</td>
                <td>
                    <a href="{{ path('app_student_show', {'id': student.id}) }}">show</a>
                    <a href="{{ path('app_student_edit', {'id': student.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <p>Hay un total de alumnos inscritos en este modulo de {{ total }}</p>
{% endblock %}

